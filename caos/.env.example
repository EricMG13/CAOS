ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://caos:change-me@db:5432/caos
POSTGRES_PASSWORD=change-me
EDGE_PROXY_SECRET=replace-with-random-secret
SESSION_SECRET=replace-with-random-secret
CAOS_STORAGE_DIR=/vault
MAX_UPLOAD_MB=250
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CPDR_AGENT_ENABLED=false
CANONICAL_AGENT_ENABLED=false
CPDR_PILOT_CASE_IDS=
CPDR_PILOT_SUBJECTS=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
CAOS_DOMAIN=localhost
OAUTH2_PROXY_CLIENT_ID=replace-me
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-me
OAUTH2_PROXY_OIDC_ISSUER_URL=https://issuer.example.com/
